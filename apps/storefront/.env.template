# Storefront Environment Variables
# Copy to .env.local: cp .env.template .env.local

# Medusa Backend URL (default: http://localhost:9000)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa Publishable API Key (retrieve from Admin Dashboard -> Settings -> Publishable API Keys)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Base URL for storefront links and redirects
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region country code (e.g. us, gb, ng)
NEXT_PUBLIC_DEFAULT_REGION=us

# Optional: Stripe Publishable Key (if using Stripe payment elements)
NEXT_PUBLIC_STRIPE_KEY=

# Resend API (for Contact Form inquiries and Newsletter Audience Subscriptions)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ayodeji Anifowose Store <onboarding@resend.dev>"
RESEND_AUDIENCE_ID=
